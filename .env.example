# Copy to .env and fill in for real Freshservice mode.
# Leave MODE=mock to run against the bundled mock server with no credentials.

MODE=mock
# mock | freshservice

# --- mock mode ---
TALLY_INGESTION_URL=http://localhost:4001

# --- freshservice mode ---
# Talks to the STANDARD public v2 Ticket API (api/v2/tickets) — no custom
# route or server-side change needed on the Freshservice/itildesk side.
FRESHSERVICE_DOMAIN=yourdomain.freshservice.com
FRESHSERVICE_API_KEY=your_api_key_here
# Required — the public Ticket API needs a real requester (email/requester_id/
# phone); there's no "system user" fallback outside an internal Rails context.
FRESHSERVICE_REQUESTER_EMAIL=
# Optional — defaults to "Incident"
FRESHSERVICE_TICKET_TYPE=Incident
FRESHSERVICE_GROUP_ID_FOR_APPROVAL=

# --- pattern engine ---
FLAP_THRESHOLD_COUNT=2
FLAP_THRESHOLD_WINDOW_MS=300000

# --- capture ---
WIFI_POLL_INTERVAL_MS=1500

# --- app-crash capture (second demo scenario, replaces the earlier VPN
# watcher — VPN detection turned out to be entangled with Wi-Fi state on
# this machine, so it always double-fired alongside the Wi-Fi scenario) ---
# Substring match against the full command line (pgrep -f), not an exact
# process name — safe for Electron apps whose binary name differs from
# their display name.
APP_CRASH_MATCH_PATTERN=Visual Studio Code

# --- resolution listener ---
POLL_TICKET_STATUS_INTERVAL_MS=4000
